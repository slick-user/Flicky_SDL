# --------------------
# Game Specific runtime files
# --------------------
*.ini     # imgui.ini, game settings, etc.
*.log
*.sav
*.pid

# --------------------
# Build artifacts
# --------------------
build/
out/
bin/
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# --------------------
# CMake
# --------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Makefile
*.ninja
.ninja_deps
.ninja_log

# --------------------
# Object files
# --------------------
*.o
*.obj
*.lo
*.slo

# --------------------
# Dependency files
# --------------------
*.d

# --------------------
# IDE / Editor
# --------------------
.vscode/
.idea/
*.user
*.suo
*.log
compile_flags.txt

# --------------------
# Language Server / Tools
# --------------------
.cache/
.clangd/
*.cache

# --------------------
# OS junk
# --------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------
# Debug / profiling
# --------------------
*.pdb
*.ilk

# --------------------
# Assets (IMPORTANT)
# --------------------
# Keep source assets, ignore generated ones
assets/exported/
assets/temp/
build/assets/  # Generated assets in build dir

# --------------------
# CI artifacts
# --------------------
*.zip
*.tar.gz
*.7z

# --------------------
# Dependencies (if using git submodules, ignore these)
# --------------------
# Uncomment if you want to track SDL3 as submodule instead
lib/SDL3/
include/SDL3/

# --------------------
# Temporary files
# --------------------
*.tmp
*.bak
*~
